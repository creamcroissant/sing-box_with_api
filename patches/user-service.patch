diff --git a/experimental/v2rayapi/user_service.go b/experimental/v2rayapi/user_service.go
new file mode 100644
index 0000000..d1f762d
--- /dev/null
+++ b/experimental/v2rayapi/user_service.go
@@ -0,0 +1,281 @@
+package v2rayapi
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	"github.com/sagernet/sing-box/adapter"
+	command "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/app/proxyman/command"
+	protocol "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/common/protocol"
+	serial "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/common/serial"
+	vless "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/proxy/vless"
+	vmess "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/proxy/vmess"
+
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+var ErrUnsupportedOperation = errors.New("runtime user management not supported by inbound")
+
+// UserService implements xray.app.proxyman.command.HandlerService with
+// semantics unified with Xray-core: same gRPC service name, methods and
+// message shell (AlterInbound + AddUserOperation/RemoveUserOperation), so a
+// single agent-side client can manage users at runtime on both sing-box and
+// Xray cores without reload.
+//
+// Credential payload is carried in the account TypedMessage:
+//   - type "xboard.user.ManagedUser": protowire-encoded {name=1,uuid=2,password=3,flow=4}
+//     used for every protocol (vless/vmess/trojan/ss/hysteria2/tuic/...).
+//   - Official Xray accounts are also accepted for interop:
+//     "xray.proxy.vless.Account" (id/flow), "xray.proxy.vmess.Account" (id).
+type UserService struct {
+	command.UnimplementedHandlerServiceServer
+	inbound adapter.InboundManager
+}
+
+func NewUserService(inbound adapter.InboundManager) *UserService {
+	return &UserService{inbound: inbound}
+}
+
+const (
+	accountTypeManagedUser = "xboard.user.ManagedUser"
+	accountTypeVLess       = "xray.proxy.vless.Account"
+	accountTypeVMess       = "xray.proxy.vmess.Account"
+	opTypeAddUser          = "xray.app.proxyman.command.AddUserOperation"
+	opTypeRemoveUser       = "xray.app.proxyman.command.RemoveUserOperation"
+)
+
+// AlterInbound applies a user-management operation to an inbound by tag.
+func (s *UserService) AlterInbound(ctx context.Context, req *command.AlterInboundRequest) (*command.AlterInboundResponse, error) {
+	if req == nil || req.Tag == "" {
+		return nil, errors.New("inbound tag is required")
+	}
+	inbound, ok := s.inbound.Get(req.Tag)
+	if !ok {
+		return nil, errors.New("inbound not found: " + req.Tag)
+	}
+	um, ok := inbound.(adapter.InboundUserManager)
+	if !ok {
+		return nil, errors.New("inbound does not support runtime user management: " + req.Tag)
+	}
+	if req.Operation == nil {
+		return nil, errors.New("operation is required")
+	}
+	typ := normalizeType(req.Operation.Type)
+	switch typ {
+	case opTypeAddUser:
+		var op command.AddUserOperation
+		if err := proto.Unmarshal(req.Operation.Value, &op); err != nil {
+			return nil, err
+		}
+		return &command.AlterInboundResponse{}, addUser(um, op.GetUser())
+	case opTypeRemoveUser:
+		var op command.RemoveUserOperation
+		if err := proto.Unmarshal(req.Operation.Value, &op); err != nil {
+			return nil, err
+		}
+		return &command.AlterInboundResponse{}, removeUser(um, op.GetEmail())
+	}
+	return nil, errors.New("unsupported operation type: " + req.Operation.Type)
+}
+
+func addUser(um adapter.InboundUserManager, user *protocol.User) error {
+	if user == nil {
+		return errors.New("user is nil")
+	}
+	mu, err := userFromProto(user)
+	if err != nil {
+		return err
+	}
+	existing := um.Users()
+	for _, u := range existing {
+		if u.Name == mu.Name && len(mu.Name) > 0 {
+			return errors.New("user already exists: " + mu.Name)
+		}
+	}
+	return um.UpdateUsers(append(existing, mu))
+}
+
+func removeUser(um adapter.InboundUserManager, name string) error {
+	if name == "" {
+		return errors.New("user name is required")
+	}
+	existing := um.Users()
+	kept := make([]adapter.ManagedUser, 0, len(existing))
+	found := false
+	for _, u := range existing {
+		if u.Name == name {
+			found = true
+			continue
+		}
+		kept = append(kept, u)
+	}
+	if !found {
+		return nil // idempotent
+	}
+	return um.UpdateUsers(kept)
+}
+
+// GetInboundUsers returns the current runtime user table of an inbound.
+func (s *UserService) GetInboundUsers(ctx context.Context, req *command.GetInboundUserRequest) (*command.GetInboundUserResponse, error) {
+	if req == nil || req.Tag == "" {
+		return nil, errors.New("inbound tag is required")
+	}
+	inbound, ok := s.inbound.Get(req.Tag)
+	if !ok {
+		return nil, errors.New("inbound not found: " + req.Tag)
+	}
+	um, ok := inbound.(adapter.InboundUserManager)
+	if !ok {
+		return nil, errors.New("inbound does not support runtime user management: " + req.Tag)
+	}
+	users := um.Users()
+	if req.GetEmail() != "" {
+		for _, u := range users {
+			if u.Name == req.GetEmail() {
+				return &command.GetInboundUserResponse{Users: []*protocol.User{userToProto(u)}}, nil
+			}
+		}
+		return &command.GetInboundUserResponse{Users: []*protocol.User{}}, nil
+	}
+	resp := &command.GetInboundUserResponse{Users: make([]*protocol.User, 0, len(users))}
+	for _, u := range users {
+		resp.Users = append(resp.Users, userToProto(u))
+	}
+	return resp, nil
+}
+
+// GetInboundUsersCount returns the number of users in an inbound.
+func (s *UserService) GetInboundUsersCount(ctx context.Context, req *command.GetInboundUserRequest) (*command.GetInboundUsersCountResponse, error) {
+	if req == nil {
+		return nil, errors.New("inbound tag is required")
+	}
+	inbound, ok := s.inbound.Get(req.Tag)
+	if !ok {
+		return nil, errors.New("inbound not found: " + req.Tag)
+	}
+	um, ok := inbound.(adapter.InboundUserManager)
+	if !ok {
+		return nil, errors.New("inbound does not support runtime user management: " + req.Tag)
+	}
+	return &command.GetInboundUsersCountResponse{Count: int64(len(um.Users()))}, nil
+}
+
+// normalizeType strips a leading "type.googleapis.com/" prefix if present.
+func normalizeType(t string) string {
+	return strings.TrimPrefix(t, "type.googleapis.com/")
+}
+
+// userFromProto converts a protocol.User (with account TypedMessage) into an
+// adapter.ManagedUser.
+func userFromProto(u *protocol.User) (adapter.ManagedUser, error) {
+	email := u.GetEmail()
+	acc := u.GetAccount()
+	if acc == nil {
+		// No account → password-style protocol; email carries the credential.
+		return adapter.ManagedUser{Name: email, UUID: email, Password: email}, nil
+	}
+	switch normalizeType(acc.Type) {
+	case accountTypeManagedUser:
+		return decodeManagedUser(acc.Value, email)
+	case accountTypeVLess:
+		var a vless.Account
+		if err := proto.Unmarshal(acc.Value, &a); err != nil {
+			return adapter.ManagedUser{}, err
+		}
+		return adapter.ManagedUser{Name: email, UUID: a.GetId(), Flow: a.GetFlow()}, nil
+	case accountTypeVMess:
+		var a vmess.Account
+		if err := proto.Unmarshal(acc.Value, &a); err != nil {
+			return adapter.ManagedUser{}, err
+		}
+		return adapter.ManagedUser{Name: email, UUID: a.GetId()}, nil
+	}
+	return adapter.ManagedUser{}, errors.New("unsupported account type: " + acc.Type)
+}
+
+// userToProto converts an adapter.ManagedUser into a protocol.User carrying a
+// ManagedUser account TypedMessage.
+func userToProto(u adapter.ManagedUser) *protocol.User {
+	return &protocol.User{
+		Email: u.Name,
+		Account: &serial.TypedMessage{
+			Type:  accountTypeManagedUser,
+			Value: encodeManagedUser(u),
+		},
+	}
+}
+
+// encodeManagedUser encodes {name=1,uuid=2,password=3,flow=4}.
+func encodeManagedUser(u adapter.ManagedUser) []byte {
+	b := make([]byte, 0, 64)
+	if u.Name != "" {
+		b = appendManagedField(b, 1, u.Name)
+	}
+	if u.UUID != "" {
+		b = appendManagedField(b, 2, u.UUID)
+	}
+	if u.Password != "" {
+		b = appendManagedField(b, 3, u.Password)
+	}
+	if u.Flow != "" {
+		b = appendManagedField(b, 4, u.Flow)
+	}
+	return b
+}
+
+func appendManagedField(b []byte, field protowire.Number, s string) []byte {
+	b = protowire.AppendTag(b, field, protowire.BytesType)
+	return protowire.AppendString(b, s)
+}
+
+func decodeManagedUser(v []byte, fallbackEmail string) (adapter.ManagedUser, error) {
+	var mu adapter.ManagedUser
+	mu.Name = fallbackEmail
+	for len(v) > 0 {
+		num, typ, n := protowire.ConsumeTag(v)
+		if n < 0 {
+			return mu, protowire.ParseError(n)
+		}
+		v = v[n:]
+		switch num {
+		case 1:
+			s, n := protowire.ConsumeString(v)
+			if n < 0 {
+				return mu, protowire.ParseError(n)
+			}
+			mu.Name = s
+			v = v[n:]
+		case 2:
+			s, n := protowire.ConsumeString(v)
+			if n < 0 {
+				return mu, protowire.ParseError(n)
+			}
+			mu.UUID = s
+			v = v[n:]
+		case 3:
+			s, n := protowire.ConsumeString(v)
+			if n < 0 {
+				return mu, protowire.ParseError(n)
+			}
+			mu.Password = s
+			v = v[n:]
+		case 4:
+			s, n := protowire.ConsumeString(v)
+			if n < 0 {
+				return mu, protowire.ParseError(n)
+			}
+			mu.Flow = s
+			v = v[n:]
+		default:
+			// skip unknown field
+			n := protowire.ConsumeFieldValue(num, typ, v)
+			if n < 0 {
+				return mu, protowire.ParseError(n)
+			}
+			v = v[n:]
+		}
+	}
+	return mu, nil
+}
