+package adapter
+
+// ManagedUser is a provider-agnostic description of an inbound user that can be
+// managed at runtime through the v2ray-api HandlerService (unified with Xray's
+// HandlerService semantics).
+//
+// Fields:
+//   - Name:     stable identifier / email. vless/vmess use the UUID itself (also
+//     exposed via UUID); trojan/shadowsocks/snell/hysteria2/tuic use a
+//     user-chosen name that must be stable so RemoveUser can reference it.
+//   - UUID:     protocol UUID (vless/vmess/tuic). Empty for password protocols.
+//   - Password: protocol password (trojan/shadowsocks/hysteria2/naive/...).
+//   - Flow:     vless flow (xtls-rprx-vision, etc). Empty when not used.
+type ManagedUser struct {
+	Name     string
+	UUID     string
+	Password string
+	Flow     string
+}
+
+// InboundUserManager is implemented by inbounds that support runtime user
+// management. It is detected via type assertion by the v2ray-api UserService.
+//
+// Implementations must call the underlying protocol Service.UpdateUsers (or the
+// equivalent) so that new connections authenticate against the updated table
+// immediately — no config reload or restart is required.
+type InboundUserManager interface {
+	Inbound
+	// UpdateUsers replaces the inbound's user table at runtime.
+	UpdateUsers(users []ManagedUser) error
+	// Users returns the current runtime user table.
+	Users() []ManagedUser
+}
