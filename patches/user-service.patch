+package v2rayapi
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	command "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/app/proxyman/command"
+	protocol "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/common/protocol"
+	serial "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/common/serial"
+	vless "github.com/sagernet/sing-box/experimental/v2rayapi/xraypb/proxy/vless"
+	"github.com/sagernet/sing-box/log"
+
+	"google.golang.org/protobuf/proto"
+)
+
+// mockInboundManager implements adapter.InboundManager minimal for tests.
+type mockInboundManager struct {
+	inbound adapter.Inbound
+}
+
+func (m *mockInboundManager) Inbounds() []adapter.Inbound { return []adapter.Inbound{m.inbound} }
+func (m *mockInboundManager) Get(tag string) (adapter.Inbound, bool) {
+	if m.inbound != nil && m.inbound.Tag() == tag {
+		return m.inbound, true
+	}
+	return nil, false
+}
+func (m *mockInboundManager) Remove(tag string) error { return nil }
+func (m *mockInboundManager) Create(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, inboundType string, options any) error {
+	return nil
+}
+func (m *mockInboundManager) Start(stage adapter.StartStage) error { return nil }
+func (m *mockInboundManager) Close() error                         { return nil }
+
+// mockInbound implements InboundUserManager (vless-like).
+type mockInbound struct {
+	tag   string
+	users []adapter.ManagedUser
+}
+
+func (h *mockInbound) Type() string                { return "vless" }
+func (h *mockInbound) Tag() string                 { return h.tag }
+func (h *mockInbound) Start(stage adapter.StartStage) error { return nil }
+func (h *mockInbound) Close() error                { return nil }
+func (h *mockInbound) UpdateUsers(users []adapter.ManagedUser) error {
+	h.users = users
+	return nil
+}
+func (h *mockInbound) Users() []adapter.ManagedUser { return h.users }
+
+func addOp(t *testing.T, email string, accType string, accVal []byte) *serial.TypedMessage {
+	t.Helper()
+	user := &protocol.User{Email: email}
+	if accType != "" {
+		user.Account = &serial.TypedMessage{Type: accType, Value: accVal}
+	}
+	opVal, err := proto.Marshal(&command.AddUserOperation{User: user})
+	if err != nil {
+		t.Fatalf("marshal AddUserOperation: %v", err)
+	}
+	return &serial.TypedMessage{Type: "xray.app.proxyman.command.AddUserOperation", Value: opVal}
+}
+
+func TestUserServiceAddRemove(t *testing.T) {
+	inb := &mockInbound{tag: "in1"}
+	svc := NewUserService(&mockInboundManager{inbound: inb})
+	ctx := context.Background()
+
+	// AddUser with official vless.Account
+	acc := &vless.Account{Id: "u1", Flow: "xtls-rprx-vision"}
+	accVal, _ := proto.Marshal(acc)
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "in1", Operation: addOp(t, "a@b.c", "xray.proxy.vless.Account", accVal)}); err != nil {
+		t.Fatalf("AddUser: %v", err)
+	}
+	if len(inb.Users()) != 1 || inb.Users()[0].UUID != "u1" || inb.Users()[0].Flow != "xtls-rprx-vision" {
+		t.Fatalf("after add: %+v", inb.Users())
+	}
+
+	// GetInboundUsers round-trip
+	g, err := svc.GetInboundUsers(ctx, &command.GetInboundUserRequest{Tag: "in1"})
+	if err != nil {
+		t.Fatalf("GetInboundUsers: %v", err)
+	}
+	if len(g.Users) != 1 || g.Users[0].Email != "a@b.c" {
+		t.Fatalf("get users: %+v", g.Users)
+	}
+
+	// duplicate add → error
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "in1", Operation: addOp(t, "a@b.c", "xray.proxy.vless.Account", accVal)}); err == nil {
+		t.Fatalf("duplicate add should fail")
+	}
+
+	// RemoveUser
+	rmVal, _ := proto.Marshal(&command.RemoveUserOperation{Email: "a@b.c"})
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "in1", Operation: &serial.TypedMessage{Type: "xray.app.proxyman.command.RemoveUserOperation", Value: rmVal}}); err != nil {
+		t.Fatalf("RemoveUser: %v", err)
+	}
+	if len(inb.Users()) != 0 {
+		t.Fatalf("after remove: %+v", inb.Users())
+	}
+
+	// count
+	cnt, err := svc.GetInboundUsersCount(ctx, &command.GetInboundUserRequest{Tag: "in1"})
+	if err != nil {
+		t.Fatalf("count: %v", err)
+	}
+	if cnt.Count != 0 {
+		t.Fatalf("count=%d want 0", cnt.Count)
+	}
+}
+
+func TestUserServiceManagedUserAccount(t *testing.T) {
+	inb := &mockInbound{tag: "in2"}
+	svc := NewUserService(&mockInboundManager{inbound: inb})
+	ctx := context.Background()
+
+	// xboard.user.ManagedUser account: {name="n1", password="p1"}
+	mu := encodeManagedUser(adapter.ManagedUser{Name: "n1", Password: "p1"})
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "in2", Operation: addOp(t, "n1", "xboard.user.ManagedUser", mu)}); err != nil {
+		t.Fatalf("AddUser managed: %v", err)
+	}
+	if len(inb.Users()) != 1 || inb.Users()[0].Name != "n1" || inb.Users()[0].Password != "p1" {
+		t.Fatalf("after managed add: %+v", inb.Users())
+	}
+
+	// roundtrip decode
+	decoded, err := decodeManagedUser(mu, "")
+	if err != nil {
+		t.Fatalf("decode: %v", err)
+	}
+	if decoded.Name != "n1" || decoded.Password != "p1" {
+		t.Fatalf("decoded: %+v", decoded)
+	}
+}
+
+func TestUserServiceErrors(t *testing.T) {
+	inb := &mockInbound{tag: "in3"}
+	svc := NewUserService(&mockInboundManager{inbound: inb})
+	ctx := context.Background()
+
+	// inbound not found
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "missing", Operation: &serial.TypedMessage{}}); err == nil {
+		t.Fatalf("missing inbound should error")
+	}
+	// operation required
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "in3", Operation: nil}); err == nil {
+		t.Fatalf("nil operation should error")
+	}
+	// unsupported op type
+	if _, err := svc.AlterInbound(ctx, &command.AlterInboundRequest{Tag: "in3", Operation: &serial.TypedMessage{Type: "x.y.Z", Value: []byte{}}}); err == nil {
+		t.Fatalf("unsupported op should error")
+	}
+}
